# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.docx

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Kiro local machine settings (MCP config with machine-specific paths)
.kiro/settings/

# Exported progress files used for local verification (personal study data —
# not source). Kept on disk, never committed.
.kiro/specs/leetsage-progress-export-import/Downloads/

# Promptfoo eval run artifacts (local/on-demand — not source). The last-run
# JSON is regenerated on every `npm run eval:promptfoo`; Promptfoo's own cache
# lives under ~/.promptfoo. Neither belongs in git.
evals-promptfoo/.last-run.json
evals-promptfoo/.judge-probe.json
evals-promptfoo/.env-probe.txt
evals-promptfoo/output/
.promptfoo/

# Local secrets for on-demand evals (BYOK). Promptfoo auto-loads .env from the
# cwd for the live LLM-as-judge. NEVER commit the key — it's the user's own.
.env
.env.local

# Secondary / personal material — kept on disk, NEVER committed (E5).
# Only the PRODUCT lives on git; everything about HOW it was built, what was
# learned, and career/resume/interview material stays local-only.
#   - docs/            : dev journal, ADRs, resume/interview prep, the learning
#                        guides, and the inner doc index — all personal/learning.
#   - .kiro/steering/  : session steering (conventions + career-project framing),
#                        maintained locally; the historian still reads/writes these.
# These files REMAIN on disk and keep being updated; they're just untracked.
docs/
.kiro/steering/
# The specs INDEX is our internal tracking (status, commit hashes, dev-journal
# breadcrumbs) — kept local. The spec FOLDERS themselves stay public (they
# document the product's features cleanly).
.kiro/specs/README.md
